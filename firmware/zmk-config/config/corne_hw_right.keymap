#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Y  &kp U  &kp I  &kp O  &kp P     &kp BSPC
                &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp RET  &kp BSPC  &mo 2  &kp RALT  &kp RGUI  &none
            >;
        };

        raise_layer {
            bindings = <
                &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp LBKT &kp RBKT
                &kp HOME &kp PGDN &kp PGUP &kp END &kp BSLH &kp RSHFT
                &kp RET  &kp BSPC  &mo 2  &kp RALT  &kp RGUI  &none
            >;
        };
    };
};
